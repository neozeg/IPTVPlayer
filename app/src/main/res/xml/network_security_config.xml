<?xml version="1.0" encoding="utf-8"?>
<!-- Many IPTV providers still serve HLS over plain HTTP. Cleartext is enabled
     deliberately; the app only connects to the source the user configures. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
